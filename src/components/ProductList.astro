---
import type { CollectionEntry } from 'astro:content';

interface Props {
  products: CollectionEntry<'products'>[];
}
const { products } = Astro.props;
const sorted = [...products].sort((a, b) => a.data.order - b.data.order);
---

<div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6">
  {
    sorted.map((p) => (
      <div>
        <h3 class="font-serif text-lg text-[var(--color-text)]">{p.data.name}</h3>
        <p class="mt-1 font-mono text-sm text-[var(--color-faint)]">
          {p.data.tagline}
        </p>
        <p class="mt-2 text-[var(--color-muted)] leading-relaxed text-[15px]">
          {p.data.description}
        </p>
      </div>
    ))
  }
</div>
