---
import type { CollectionEntry } from 'astro:content';

interface Props {
  publications: CollectionEntry<'publications'>[];
}
const { publications } = Astro.props;

// Newest first.
const sorted = [...publications].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Link priority: project page > conference official paper > arXiv.
const primaryLink = (d: CollectionEntry<'publications'>['data']) =>
  d.urlProject ?? d.urlPaper ?? d.urlPdf;

// Show the first few by default; the rest reveal via the toggle button.
const VISIBLE = 5;
const total = sorted.length;
const hasMore = total > VISIBLE;
---

<ul class="divide-y divide-[var(--color-line)]" data-pub-list>
  {
    sorted.map((pub, i) => {
      const { title, venue, theme } = pub.data;
      const href = primaryLink(pub.data);
      const extra = i >= VISIBLE;
      return (
        <li class:list={['group py-4', extra && 'hidden']} data-extra={extra ? '' : undefined}>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-6">
            {/* Date(venue) + Category — meta column, Anthropic-style */}
            <div class="shrink-0 sm:w-64 flex flex-wrap items-baseline gap-x-2 font-mono text-sm">
              <span class="text-[var(--color-text)]">{venue}</span>
              <span class="text-[var(--color-faint)]">· {theme}</span>
            </div>
            {/* Title */}
            <h3 class="mt-1 sm:mt-0 font-serif text-lg leading-snug text-[var(--color-text)]">
              {href ? (
                <a href={href} target="_blank" rel="noopener" class="link-underline">
                  {title}
                </a>
              ) : (
                title
              )}
            </h3>
          </div>
        </li>
      );
    })
  }
</ul>

{
  hasMore && (
    <button
      type="button"
      data-pub-toggle
      aria-expanded="false"
      data-label-more={`Show all (${total})`}
      data-label-less="Show fewer"
      class="mt-4 font-mono text-sm text-[var(--color-muted)] hover:text-[var(--color-text)] link-underline"
    >
      Show all ({total})
    </button>
  )
}

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-pub-toggle]');
  const extras = document.querySelectorAll<HTMLElement>('[data-extra]');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    extras.forEach((el) => el.classList.toggle('hidden', expanded));
    btn.setAttribute('aria-expanded', String(!expanded));
    btn.textContent = expanded
      ? btn.dataset.labelMore!
      : btn.dataset.labelLess!;
  });
</script>
