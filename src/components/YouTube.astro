---
/*
  Lightweight YouTube embed — uses the privacy-friendly nocookie domain and
  lazy-loads the iframe. No external dependency.
*/
interface Props {
  id: string;
  title?: string;
  caption?: string;
  start?: number; // start offset in seconds
}
const { id, title = 'YouTube video', caption, start } = Astro.props;
const src =
  `https://www.youtube-nocookie.com/embed/${id}` +
  (start ? `?start=${start}` : '');
---

<figure class="my-4">
  <div
    class="relative w-full overflow-hidden rounded border border-[var(--color-line)]"
    style="aspect-ratio: 16 / 9;"
  >
    <iframe
      class="absolute inset-0 w-full h-full"
      src={src}
      title={title}
      loading="lazy"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen></iframe>
  </div>
  {
    caption && (
      <figcaption class="mt-2 text-sm font-mono text-[var(--color-faint)]">
        {caption}
      </figcaption>
    )
  }
</figure>
